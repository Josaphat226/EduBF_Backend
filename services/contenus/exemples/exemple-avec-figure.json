          "enonce": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "On considère le nombre "
                  },
                  {
                    "type": "formuleInline",
                    "attrs": {
                      "latex": "A = \\sqrt{50} - \\sqrt{18} + \\sqrt{8}"
                    }
                  },
