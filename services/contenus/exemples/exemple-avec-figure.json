                      ]
                    },
                    "etapes": [
                      {
                        "doc": {
                          "type": "doc",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "On reconnaît l’identité remarquable "
                                },
                                {
                                  "type": "formuleInline",
                                  "attrs": {
                                    "latex": "(a+b)(a-b) = a^2 - b^2"
                                  }
                                },
                                {
                                  "type": "text",
                                  "text": " :"
                                }
                              ]
                            },
                            {
                              "type": "formuleBloc",
                              "attrs": {
                                "latex": "B = (\\sqrt{5})^2 - 1^2 = 5 - 1 = 4"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "qst-0002b",
                  "enonce": {
                    "type": "doc",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Calculer "
                          },
                          {
                            "type": "formuleInline",
                            "attrs": {
                              "latex": "C"
                            }
                          },
                          {
                            "type": "text",
                            "text": "."
                          }
                        ]
                      }
                    ]
