                      },
                      {
                        "type": "formuleInline",
                        "attrs": {
                          "latex": "C = (2\\sqrt{3})^2"
                        }
                      },
                      {
                        "type": "text",
                        "text": "."
                      }
                    ]
                  }
                ]
              },
              "sous_questions": [
                {
                  "id": "qst-0002a",
                  "enonce": {
                    "type": "doc",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Calculer "
                          },
                          {
                            "type": "formuleInline",
                            "attrs": {
                              "latex": "B"
                            }
                          },
