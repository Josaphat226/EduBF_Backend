          },
          "questions": [
            {
              "id": "qst-0001",
              "enonce": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Écrire "
                      },
                      {
                        "type": "formuleInline",
                        "attrs": {
                          "latex": "A"
                        }
                      },
                      {
                        "type": "text",
                        "text": " sous la forme "
                      },
                      {
                        "type": "formuleInline",
                        "attrs": {
                          "latex": "a\\sqrt{2}"
                        }
                      },
                      {
                        "type": "text",
                        "text": ", où "
                      },
                      {
                        "type": "formuleInline",
                        "attrs": {
                          "latex": "a"
                        }
                      },
                      {
                        "type": "text",
                        "text": " est un entier."
                      }
                    ]
                  },
                  {
                    "type": "zoneReponse",
                    "attrs": {
                      "lignes": 3
                    }
                  }
                ]
              },
              "points": 2,
              "corrige": {
                "reponse_attendue": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "formuleInline",
                          "attrs": {
                            "latex": "A = 4\\sqrt{2}"
                          }
                        }
                      ]
                    }
                  ]
                },
                "methode": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "On décompose chaque radical en faisant apparaître le plus grand carré parfait, puis on regroupe les termes en "
                        },
                        {
                          "type": "formuleInline",
                          "attrs": {
                            "latex": "\\sqrt{2}"
                          }
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                "etapes": [
                  {
                    "titre": "Décomposer chaque radical",
                    "doc": {
                      "type": "doc",
                      "content": [
                        {
                          "type": "formuleBloc",
                          "attrs": {
                            "latex": "\\sqrt{50} = \\sqrt{25 \\times 2} = 5\\sqrt{2}"
                          }
                        },
                        {
                          "type": "formuleBloc",
                          "attrs": {
                            "latex": "\\sqrt{18} = \\sqrt{9 \\times 2} = 3\\sqrt{2}"
                          }
                        },
                        {
                          "type": "formuleBloc",
                          "attrs": {
                            "latex": "\\sqrt{8} = \\sqrt{4 \\times 2} = 2\\sqrt{2}"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "titre": "Regrouper",
                    "doc": {
                      "type": "doc",
                      "content": [
                        {
                          "type": "formuleBloc",
                          "attrs": {
                            "latex": "A = 5\\sqrt{2} - 3\\sqrt{2} + 2\\sqrt{2} = (5 - 3 + 2)\\sqrt{2} = 4\\sqrt{2}"
                          }
                        }
                      ]
                    }
                  }
                ],
                "bareme": [
                  {
                    "critere": "Décomposition correcte des trois radicaux",
                    "points": 1.5
                  },
                  {
                    "critere": "Regroupement et résultat",
                    "points": 0.5
                  }
                ]
              }
            },
            {
              "id": "qst-0002",
              "enonce": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "On donne "
