                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "formuleInline",
                              "attrs": {
                                "latex": "C = 12"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "etapes": [
                      {
                        "doc": {
                          "type": "doc",
                          "content": [
                            {
                              "type": "formuleBloc",
                              "attrs": {
                                "latex": "C = 2^2 \\times (\\sqrt{3})^2 = 4 \\times 3 = 12"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
