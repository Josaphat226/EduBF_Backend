                    "text": "."
                  }
                ]
              },
              {
                "type": "figure",
                "attrs": {
                  "src": "contenus/2d41bb7e7e9c56580b01e02179bcb51ebe1d36ffe4ce6d799e8b89ee13a3bc73.svg",
